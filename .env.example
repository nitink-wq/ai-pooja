# Copy to .env for local non-docker runs (Node 20+ loads it with
# --env-file, e.g. `node --env-file=.env src/server.js`).

PORT=3000

# Shared HMAC secret for the payment tokens (order token + payToken). Any
# long random string. REQUIRED wherever more than one replica runs: a token
# minted by one pod is only valid on another if they share this. Unset, each
# process uses its own random secret (fine for a single local process).
#PAY_TOKEN_SECRET=replace-me-with-a-long-random-string

# Razorpay — test mode keys to start. Both must be set for real checkout;
# leave unset and the payment step runs in mock mode (simulated success,
# no charge, no Razorpay call at all).
#RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
#RAZORPAY_KEY_SECRET=replace-me

# Anam.ai — required for a real live-avatar call. Leave ANAM_API_KEY unset
# and the call step runs in mock mode (simulated call screen, no Anam
# request at all).
#ANAM_API_KEY=replace-me
# Persona built in Anam Lab (bundles its avatar + voice). Its system prompt
# is pushed separately — run `npm run anam:set-prompt` after setting this
# (see src/config.js ANAM_SYSTEM_PROMPT and scripts/set-anam-system-prompt.js).
#ANAM_PERSONA_ID=replace-me
# Informational only — the ElevenLabs voice/model this persona uses, already
# configured on the persona itself. Not sent in the API call.
#ANAM_VOICE_ID=replace-me
#ANAM_VOICE_MODEL_ID=replace-me
